# Cloudflare static-assets response headers.
# Hashed build output never changes, so cache it for good; the service worker
# and app shell must always revalidate so updates reach people.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/sw.js
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

# No COOP/COEP here: they break the Google sign-in popup and Picker iframe.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
